{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/catalog/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/catalog" }]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/orders/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/orders" }]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/inventory/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/inventory" }]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/payments/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/payments" }]
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": { "Address": "http://catalog-api.ecommerce-dev.local:8080/" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-api": { "Address": "http://order-api.ecommerce-dev.local:8080/" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-api": { "Address": "http://inventory-api.ecommerce-dev.local:8080/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-api": { "Address": "http://payment-api.ecommerce-dev.local:8080/" }
        }
      }
    }
  },
  "Authentication": {
    "Authority": "",
    "Audience": "api"
  }
}

{
  "Logging": {
    "LogLevel": { "Default": "Information", "Microsoft.AspNetCore": "Warning" }
  },
  "ReverseProxy": {
    "Routes": {
      "catalog-route": {
        "ClusterId": "catalog-cluster",
        "Match": { "Path": "/api/catalog/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/catalog" }]
      },
      "order-route": {
        "ClusterId": "order-cluster",
        "Match": { "Path": "/api/orders/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/orders" }]
      },
      "inventory-route": {
        "ClusterId": "inventory-cluster",
        "Match": { "Path": "/api/inventory/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/inventory" }]
      },
      "payment-route": {
        "ClusterId": "payment-cluster",
        "Match": { "Path": "/api/payments/{**catch-all}" },
        "Transforms": [{ "PathRemovePrefix": "/api/payments" }]
      },
      "identity-route": {
        "ClusterId": "identity-cluster",
        "Match": { "Path": "/connect/{**catch-all}" }
      }
    },
    "Clusters": {
      "catalog-cluster": {
        "Destinations": {
          "catalog-api": { "Address": "http://catalog-api:8080/" }
        }
      },
      "order-cluster": {
        "Destinations": {
          "order-api": { "Address": "http://order-api:8080/" }
        }
      },
      "inventory-cluster": {
        "Destinations": {
          "inventory-api": { "Address": "http://inventory-api:8080/" }
        }
      },
      "payment-cluster": {
        "Destinations": {
          "payment-api": { "Address": "http://payment-api:8080/" }
        }
      },
      "identity-cluster": {
        "Destinations": {
          "identity-api": { "Address": "http://identity-api:8080/" }
        }
      }
    }
  },
  "Authentication": {
    "Authority": "http://identity-api:8080",
    "Audience": "api"
  }
}

# =============================================================================
# ECommerce Monorepo – Environment Variables
# Production: AWS managed services. Local dev: see docker-compose.local.yml
# DO NOT commit real credentials. Use AWS Secrets Manager in production.
# =============================================================================

# ── AWS ───────────────────────────────────────────────────────────────────────
AWS_REGION=us-east-1
ECR_REGISTRY=<account-id>.dkr.ecr.us-east-1.amazonaws.com
IMAGE_TAG=latest
ASPNETCORE_ENVIRONMENT=Production

# ── Amazon RDS (PostgreSQL 16) ────────────────────────────────────────────────
# These are injected by CDK/CI into ECS task environment or Secrets Manager
IDENTITY_DB_CONNECTION=Host=<rds-endpoint>.rds.amazonaws.com;Port=5432;Database=identity_db;Username=ecommerce_admin;Password=<secret>;SSL Mode=Require
CATALOG_DB_CONNECTION=Host=<rds-endpoint>.rds.amazonaws.com;Port=5432;Database=catalog_db;Username=ecommerce_admin;Password=<secret>;SSL Mode=Require
ORDER_DB_CONNECTION=Host=<rds-endpoint>.rds.amazonaws.com;Port=5432;Database=order_db;Username=ecommerce_admin;Password=<secret>;SSL Mode=Require
INVENTORY_DB_CONNECTION=Host=<rds-endpoint>.rds.amazonaws.com;Port=5432;Database=inventory_db;Username=ecommerce_admin;Password=<secret>;SSL Mode=Require
PAYMENT_DB_CONNECTION=Host=<rds-endpoint>.rds.amazonaws.com;Port=5432;Database=payment_db;Username=ecommerce_admin;Password=<secret>;SSL Mode=Require

# ── Amazon ElastiCache Serverless (Redis, TLS required) ───────────────────────
ELASTICACHE_ENDPOINT=<cluster>.serverless.use1.cache.amazonaws.com:6379,ssl=True,abortConnect=False

# ── Amazon MQ (RabbitMQ mode, AMQPS) ─────────────────────────────────────────
AMAZON_MQ_ENDPOINT=amqps://<broker-id>.mq.us-east-1.amazonaws.com:5671
AMAZON_MQ_USER=ecommerce_mq
AMAZON_MQ_PASSWORD=<from-secrets-manager>

# ── Amazon OpenSearch Service ─────────────────────────────────────────────────
OPENSEARCH_ENDPOINT=https://<domain>.<region>.es.amazonaws.com

# ── Identity ──────────────────────────────────────────────────────────────────
IDENTITY_AUTHORITY=https://<your-domain>/identity

# ── Notification ──────────────────────────────────────────────────────────────
SENDGRID_API_KEY=SG.REPLACE_ME_FROM_SECRETS_MANAGER

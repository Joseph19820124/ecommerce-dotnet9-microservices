# =============================================================================
# ECommerce Monorepo – Environment Variables
# Copy this file to .env and fill in secrets before running docker compose.
# DO NOT commit the filled-in .env file to source control.
# =============================================================================

# ── Docker registry / image tag ───────────────────────────────────────────────
DOCKER_REGISTRY=ecommerce
TAG=latest

# ── PostgreSQL ────────────────────────────────────────────────────────────────
POSTGRES_USER=ecommerce_admin
POSTGRES_PASSWORD=P@ssw0rd!Postgres

# Database names (created by infra/postgres/init-databases.sh)
CATALOG_DB=catalog_db
ORDER_DB=order_db
IDENTITY_DB=identity_db
INVENTORY_DB=inventory_db
PAYMENT_DB=payment_db

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=R3d!sSecretPass

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USER=ecommerce_mq
RABBITMQ_PASSWORD=Rabb!tMQPass
RABBITMQ_VHOST=ecommerce

# ── Elasticsearch ─────────────────────────────────────────────────────────────
ELASTIC_PASSWORD=El@sticPass123

# ── pgAdmin ───────────────────────────────────────────────────────────────────
PGADMIN_EMAIL=admin@ecommerce.local
PGADMIN_PASSWORD=PgAdm!nPass

# ── SendGrid (Notification service) ──────────────────────────────────────────
SENDGRID_API_KEY=SG.REPLACE_ME
